#CONTAINER-NAME
CONTAINER_NAME=safrano9999-mtg

#container-command: image
# Start each MCP service independently; optional booleans: true or false.
#default-preset: true
MTG_COMMANDER_ENABLED=true

#default-preset: true
MTG_ARCHIDEKT_ENABLED=true

#default-preset: 0.0.0.0
MTG_HOST=0.0.0.0

#default-preset: 8000
MTG_COMMANDER_PORT=8000

#default-preset: 8001
MTG_ARCHIDEKT_PORT=8001
