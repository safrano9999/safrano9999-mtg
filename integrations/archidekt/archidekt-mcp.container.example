[Unit]
Description=Archidekt MCP with shared Redis
After=network-online.target redis.service
Wants=network-online.target
Requires=redis.service

[Container]
Image=ghcr.io/dnviti/archidekt-mcp-server@sha256:40faa0f80522162eb1465bad112ba82e1c46dd04536f21419248bfcb49266f8d
ContainerName=archidekt-mcp
Network=rafael
EnvironmentFile=%h/.config/containers/archidekt-mcp.env
Volume=%h/.config/containers/archidekt-mcp-patches/authenticated.py:/usr/local/lib/python3.13/site-packages/archidekt_commander_mcp/integrations/authenticated.py:ro,Z
Volume=%h/.config/containers/archidekt-mcp-patches/public_collection.py:/usr/local/lib/python3.13/site-packages/archidekt_commander_mcp/integrations/public_collection.py:ro,Z
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
