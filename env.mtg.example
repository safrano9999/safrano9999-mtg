# Optional shared Bearer token for both MCP endpoints. Blank disables MCP authentication.
#secret
MTG_MCP_BEARER=example: openssl rand -hex 32

# Optional Archidekt login; both fields are needed for account/deck tools.
ARCHIDEKT_USERNAME=

#secret
ARCHIDEKT_PASSWORD=

# Optional deck reference list, e.g. 12372, 17244. Does not restrict access.
ARCHIDECKS=
