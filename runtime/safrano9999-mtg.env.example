# Copy to ~/.config/containers/safrano9999-mtg.env and chmod 600.
# Preserve the existing Archidekt OAuth/Redis values from archidekt-mcp.env.
ARCHIDEKT_MCP_REDIS_URL=redis://redis:6379/1
ARCHIDEKT_MCP_REDIS_KEY_PREFIX=mtg-archidekt
ARCHIDEKT_MCP_AUTH_ENABLED=true
ARCHIDEKT_MCP_PUBLIC_BASE_URL=http://localhost:8000
ARCHIDEKT_MCP_HOST=0.0.0.0
ARCHIDEKT_MCP_PORT=8000
ARCHIDEKT_MCP_USER_AGENT=archidekt-mcp-server/0.3 (safrano9999 MTG)
ARCHIDEKT_MCP_AUTH_SCHEME=bearer

MTG_MCP_BEARER=
# Retained compatibility inputs from the former Fedora stack.
ARCHIDEKT_USERNAME=
ARCHIDEKT_PASSWORD=
ARCHIDECKS=
MTG_COMMANDER_ENABLED=true
MTG_COMMANDER_PORT=8001
MTG_HOST=0.0.0.0
