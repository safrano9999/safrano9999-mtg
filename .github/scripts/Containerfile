# Source of truth: SCRIPTS/githubactions. Generated copies are overwritten.
FROM docker.io/library/golang:1.27.1 AS commander-build
ARG COMMANDER_REVISION=cce0378b5aa92b0cc2a9b977859f83baa8d8d038
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
RUN git init && git remote add origin https://github.com/nathanmartins/mtg-mcp.git \
    && git -c http.version=HTTP/1.1 fetch --depth=1 origin "${COMMANDER_REVISION}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${COMMANDER_REVISION}" \
    && go test ./... \
    && go build -trimpath -buildvcs=false -ldflags="-s -w" -o /mtg-mcp .

FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install systemd python3 python3-pip nodejs npm ca-certificates \
    && dnf clean all && rm -rf /var/cache/dnf \
    && systemctl mask getty.target console-getty.service systemd-logind.service \
    && systemctl set-default multi-user.target
ENV container=podman PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    MTG_HOST=0.0.0.0 MTG_COMMANDER_PORT=8000 MTG_ARCHIDEKT_PORT=8001 \
    MTG_COMMANDER_ENABLED=true MTG_ARCHIDEKT_ENABLED=true
WORKDIR /opt/mtg
COPY requirements.txt package.json package-lock.json ./
RUN python3 -m pip install --no-cache-dir -r requirements.txt \
    && python3 -m pip check \
    && npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force
COPY --from=commander-build /mtg-mcp /usr/local/bin/mtg-mcp
COPY --from=commander-build /src/LICENSE /usr/share/licenses/mtg-commander/LICENSE
COPY index.js server.py LICENSE ./
COPY utils/ ./utils/
COPY systemd/*.service /etc/systemd/system/
RUN systemctl enable mtg-commander.service mtg-archidekt.service
LABEL org.opencontainers.image.title="safrano9999-mtg" \
      org.opencontainers.image.description="Fedora 44: Commander research and Archidekt deck MCP services" \
      org.opencontainers.image.source="https://github.com/safrano9999/safrano9999-mtg"
EXPOSE 8000 8001
STOPSIGNAL SIGRTMIN+3
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python3 -c 'import os,urllib.request; [urllib.request.urlopen("http://127.0.0.1:"+os.getenv("MTG_"+name+"_PORT",str(port))+"/healthz",timeout=4).read() for name,port in [("COMMANDER",8000),("ARCHIDEKT",8001)] if os.getenv("MTG_"+name+"_ENABLED","true") != "false"]'
ENTRYPOINT ["/sbin/init"]
