# syntax=docker/dockerfile:1.7
# Source of truth: SCRIPTS/githubactions. Generated copies are overwritten.
FROM docker.io/library/golang:1.27.3@sha256:f20d83a83e18dbd2a4714b8ffd4b30b287b6243962dd75608e86abcc63ba4efc AS commander-build
# nathanmartins/mtg-mcp v3.2.1 (peeled release commit).
ARG COMMANDER_REVISION=5c91e7dfaf82a60e919d0dd7acb5a33400daf852
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
# External Archidekt E2E checks opt out through the upstream short-mode flag.
RUN git init && git remote add origin https://github.com/nathanmartins/mtg-mcp.git \
    && git -c http.version=HTTP/1.1 fetch --depth=1 origin "${COMMANDER_REVISION}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${COMMANDER_REVISION}" \
    && go test -short ./... \
    && go build -trimpath -buildvcs=false \
         -ldflags="-s -w -X main.version=3.2.1 -X main.commit=${COMMANDER_REVISION}" \
         -o /mtg-mcp ./cmd/mtg-mcp

# Verified wheels bootstrap trust updates without using an old pip CA bundle.
FROM scratch AS python-trust
ADD --checksum=sha256:fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70 \
    https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl /pip-26.2.2-py3-none-any.whl
ADD --checksum=sha256:42d35340cc5b9ba78e818ddbff0c5b1c2b779de448a340fd1b989f5fa8670e1b \
    https://files.pythonhosted.org/packages/c4/51/29046e48f693c54e5b7412216d447a1d8362c9653148d98c02cdf65fa733/certifi-2026.10.19-py3-none-any.whl /certifi-2026.10.19-py3-none-any.whl

FROM scratch AS node-release
ADD --checksum=sha256:6170b2d474e1c626f43cff3adc118df9fe3b573258a4fc3d850c8dbc6b079bbd \
    https://nodejs.org/dist/v26.12.1/node-v26.12.1-linux-x64.tar.xz /node.tar.xz

FROM fedora45-approved-beta
RUN --mount=type=bind,from=node-release,source=/node.tar.xz,target=/tmp/node.tar.xz \
    dnf -y upgrade \
    && dnf -y install systemd python3.14 ca-certificates libatomic libstdc++ tar xz \
    && tar --extract --xz --file=/tmp/node.tar.xz --directory=/usr/local \
         --strip-components=1 --no-same-owner \
    && ln -s /usr/local/bin/node /usr/bin/node \
    && ln -s /usr/local/bin/npm /usr/bin/npm \
    && ln -s /usr/local/bin/npx /usr/bin/npx \
    && test "$(/usr/bin/node --version)" = "v26.12.1" \
    && ln -s /usr/bin/python3.14 /usr/local/bin/python3 \
    && dnf clean all && rm -rf /var/cache/dnf \
    && systemctl mask getty.target console-getty.service systemd-logind.service \
    && systemctl set-default multi-user.target
ENV container=podman PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    MTG_HOST=0.0.0.0 \
    MTG_COMMANDER_ENABLED=true MTG_ARCHIDEKT_ENABLED=true
RUN --mount=type=bind,from=python-trust,target=/tmp/python-trust \
    python3 -c "import ensurepip, pathlib, shutil, sysconfig; seed = pathlib.Path(sysconfig.get_config_var('WHEEL_PKG_DIR') or pathlib.Path(ensurepip.__file__).with_name('_bundled')); [p.unlink() for p in seed.glob('pip-*.whl')]; shutil.copy('/tmp/python-trust/pip-26.2.2-py3-none-any.whl', seed); source = pathlib.Path(ensurepip.__file__); text = source.read_text(); old = ensurepip._PIP_VERSION; assert text.count(old) == 1; source.write_text(text.replace(old, '26.2.2')); ensurepip._PIP_VERSION = '26.2.2'; assert ensurepip.version() == '26.2.2'" \
    && PYTHONPATH=/tmp/python-trust/pip-26.2.2-py3-none-any.whl python3 -m pip install --break-system-packages --no-index --upgrade /tmp/python-trust/*.whl \
    && python3 -c "import ensurepip, pip, certifi, pip._vendor.certifi as bundled; assert ensurepip.version() == '26.2.2'; assert pip.__version__ == '26.2.2'; assert certifi.__version__ == '2026.10.19'; assert bundled.__version__ == '2026.10.19'"
WORKDIR /opt/mtg
COPY requirements.txt package.json package-lock.json ./
RUN python3 -m pip install --no-cache-dir -r requirements.txt \
    && python3 -m pip check \
    && python3 -c "import ensurepip, pip, certifi, pip._vendor.certifi as bundled; assert ensurepip.version() == '26.2.2'; assert pip.__version__ == '26.2.2'; assert certifi.__version__ == '2026.10.19'; assert bundled.__version__ == '2026.10.19'" \
    && npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force
COPY --from=commander-build /mtg-mcp /usr/local/bin/mtg-mcp
COPY --from=commander-build /src/LICENSE /usr/share/licenses/mtg-commander/LICENSE
COPY index.js server.py LICENSE ./
COPY utils/ ./utils/
COPY systemd/*.service /etc/systemd/system/
RUN sed -i 's|/usr/bin/python3 |/usr/local/bin/python3 |' /etc/systemd/system/mtg-*.service \
    && systemctl enable mtg-commander.service mtg-archidekt.service
LABEL io.safrano9999.nodejs.version="26.12.1" \
      org.opencontainers.image.title="safrano9999-mtg" \
      org.opencontainers.image.description="Fedora 45: Commander research and Archidekt deck MCP services" \
      org.opencontainers.image.source="https://github.com/safrano9999/safrano9999-mtg"
EXPOSE 8000 8001
STOPSIGNAL SIGRTMIN+3
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python3 -c 'import os,urllib.request; [urllib.request.urlopen("http://127.0.0.1:"+str(port)+"/healthz",timeout=4).read() for name,port in [("ARCHIDEKT",8000),("COMMANDER",8001)] if os.getenv("MTG_"+name+"_ENABLED","true") != "false"]'
ENTRYPOINT ["/sbin/init"]

LABEL org.opencontainers.image.base.name="Fedora-Container-Base-Generic-45_Beta-1.3.x86_64" \
      org.opencontainers.image.base.digest="sha256:5f6c3c965a3af6b0faa21efc46ab46b9acfb1e1a8f69cec63fd6e44bdcf270cb"
