# Source of truth: SCRIPTS/githubactions. Generated copies are overwritten.
FROM docker.io/library/golang:1.27@sha256:3680233e3204827fbdc66088528ae6d4b3d034f51d03a99d454f6de034888244 AS commander-build
ARG COMMANDER_REPOSITORY=https://github.com/safrano9999/safrano9999-nathanmtg.git
ARG COMMANDER_REVISION=dc85b7e3683aa5f1e9841d3275e9ea69c6f24932
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
RUN git init && git remote add origin "${COMMANDER_REPOSITORY}" \
    && git -c http.version=HTTP/1.1 fetch --depth=1 origin "${COMMANDER_REVISION}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${COMMANDER_REVISION}" \
    && go test ./... \
    && go build -trimpath -buildvcs=false -ldflags="-s -w" -o /mtg-mcp .

FROM ghcr.io/dnviti/archidekt-mcp-server@sha256:40faa0f80522162eb1465bad112ba82e1c46dd04536f21419248bfcb49266f8d
USER root

# Keep the Archidekt runtime on the MCP SDK version used by this deployment;
# mtg-commander now provides its own native Streamable HTTP transport.
RUN python -m pip install --no-cache-dir --no-compile "mcp==1.27.0"

COPY --from=commander-build /mtg-mcp /usr/local/bin/mtg-mcp
COPY --from=commander-build /src/LICENSE /usr/share/licenses/mtg-commander/LICENSE
COPY supervisor.py /usr/local/bin/safrano9999-mtg-supervisor.py
COPY integrations/archidekt/runtime/authenticated.py /usr/local/lib/python3.13/site-packages/archidekt_commander_mcp/integrations/authenticated.py
COPY integrations/archidekt/runtime/http_base.py /usr/local/lib/python3.13/site-packages/archidekt_commander_mcp/integrations/http_base.py
COPY integrations/archidekt/runtime/public_collection.py /usr/local/lib/python3.13/site-packages/archidekt_commander_mcp/integrations/public_collection.py
COPY integrations/archidekt/runtime/account_identity.py /usr/local/lib/python3.13/site-packages/archidekt_commander_mcp/services/account_identity.py
RUN mkdir -p /opt/safrano9999-mtg \
    && chmod 0755 /usr/local/bin/mtg-mcp /usr/local/bin/safrano9999-mtg-supervisor.py \
    && chown appuser:appuser /opt/safrano9999-mtg \
    && python -m compileall -q /opt/safrano9999-mtg \
      /usr/local/lib/python3.13/site-packages/archidekt_commander_mcp/integrations \
      /usr/local/lib/python3.13/site-packages/archidekt_commander_mcp/services

ENV MTG_COMMANDER_ENABLED=true \
    MTG_COMMANDER_PORT=8001 \
    MTG_MCP_TRANSPORT=streamable-http \
    MTG_MCP_HOST=0.0.0.0 \
    MTG_MCP_PORT=8001 \
    MTG_MCP_HTTP_PATH=/mcp \
    ARCHIDEKT_MCP_HOST=0.0.0.0 \
    ARCHIDEKT_MCP_PORT=8000 \
    ARCHIDEKT_MCP_TRANSPORT=streamable-http \
    ARCHIDEKT_MCP_STREAMABLE_HTTP_PATH=/mcp
WORKDIR /opt/safrano9999-mtg
USER appuser
EXPOSE 8000 8001
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 CMD python -c 'import os,urllib.request; urllib.request.urlopen("http://127.0.0.1:"+os.getenv("MTG_COMMANDER_PORT","8001")+"/healthz", timeout=4).read()'
ENTRYPOINT ["python", "/usr/local/bin/safrano9999-mtg-supervisor.py"]
